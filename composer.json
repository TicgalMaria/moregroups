{
	"name": "ticgal/moregroups",
	"description": "More Groups plugin for GLPI",
	"license": "AGPL-3.0-or-later",
	"require": {
	},
	"require-dev": {
		"glpi-project/tools": "^0.7.5",
		"phpunit/phpunit": "^11",
		"squizlabs/php_codesniffer": "^3.7"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"GlpiPlugin\\Moregroups\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Glpi\\Tools\\": "../../tools/src/",
			"GlpiPlugin\\Moregroups\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
